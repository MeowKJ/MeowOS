# Generic Rockchip RK35xx (RK3568 / RK3588 / RK3566) capability profile.
# No vendor-specific pinout is assumed; UI components bind exclusively to
# the HAL and abstract profiles.
MEOW_BOARD_PROFILE=RK35XX_GENERIC
MEOW_CAP_DISPLAY=1
MEOW_CAP_TOUCH=1
MEOW_CAP_POWER=optional
MEOW_CAP_AUDIO=optional
MEOW_CAP_WIFI=optional
MEOW_CAP_ETHERNET_PORTS=optional
MEOW_CAP_NVME=optional
MEOW_CAP_USB3=optional
MEOW_CAP_PCIE=optional
