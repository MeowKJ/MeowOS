# Generic Allwinner A733 capability profile. No vendor pinout is assumed.
# A concrete board must provide its own display/touch/DT profile later.
MEOW_BOARD_PROFILE=A733_GENERIC
MEOW_CAP_DISPLAY=1
MEOW_CAP_TOUCH=1
MEOW_CAP_POWER=optional
MEOW_CAP_AUDIO=optional
MEOW_CAP_WIFI=optional
MEOW_CAP_ETHERNET_PORTS=optional
MEOW_CAP_NVME=optional
MEOW_CAP_USB3=optional
MEOW_CAP_PCIE=optional
