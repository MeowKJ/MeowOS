# Radxa Cubie A5E capability profile. Board-specific DT overlays remain
# deployment-owned; this file only describes the public MeowOS capabilities.
MEOW_BOARD_PROFILE=A5E
MEOW_CAP_DISPLAY=1
MEOW_CAP_TOUCH=1
MEOW_CAP_POWER=1
MEOW_CAP_AUDIO=1
MEOW_CAP_WIFI=1
MEOW_CAP_ETHERNET_PORTS=2
MEOW_CAP_NVME=1
MEOW_CAP_USB3_PCIe_EXCLUSIVE=1
