[Unit]
Description=Mindustry game session for Meow OS
Conflicts=meow-os.service
After=systemd-user-sessions.service

[Service]
Type=simple
# Stop the DRM/EGLFS desktop before taking DRM master for the X11 game.
# Conflicts alone is not sufficient when the desktop was started manually or
# by a separate transaction; make the hand-off explicit and deterministic.
ExecStartPre=/bin/systemctl stop meow-os.service
ExecStart=/opt/mindustry/meow-mindustry-launch.sh
ExecStopPost=-/bin/systemctl start meow-os.service
# A stuck IME/X11 helper must never hold the desktop hand-off indefinitely.
TimeoutStopSec=10s
KillMode=control-group
Restart=no

[Install]
WantedBy=multi-user.target
